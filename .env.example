# Copy to .env and fill in. Only OPENROUTER_API_KEY is required; everything
# else has a working default.

# --- required ---
OPENROUTER_API_KEY=sk-or-v1-...

# --- generation ---
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=meta-llama/llama-3.3-70b-instruct
LLM_TIMEOUT=30
LLM_MAX_TOKENS=700
LLM_MAX_RETRIES=2
# OpenRouter provider routing: throughput | price | latency | default.
# Left on 'default' the router picked a provider running at ~8 tok/s (24s
# responses). 'throughput' brings that to ~2.7s for ~4x the token price.
LLM_PROVIDER_SORT=throughput

# --- retrieval ---
# sentence-transformers (Qwen, needs torch) | fastembed (ONNX, no torch)
EMBED_BACKEND=sentence-transformers
EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RETRIEVE_K=30
RERANK_TOP_N=6

# --- api ---
MAX_QUERY_LENGTH=500
RATE_LIMIT=10/minute
# Comma-separated. Use explicit origins in production, not "*".
CORS_ORIGINS=*
LOG_LEVEL=INFO
